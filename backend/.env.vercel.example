APP_NAME=Thinkers
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_CONNECT_TIMEOUT=5
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/var/www/html/certs/aiven-ca.pem

CACHE_STORE=database
CACHE_LIMITER=database
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids

SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_COOKIE=thinkers_session
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true

FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_MAX_AGE=600
SANCTUM_STATEFUL_DOMAINS=your-frontend.vercel.app

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=s3
COURSE_MEDIA_FILESYSTEM_DRIVER=local
CERTIFICATE_FILESYSTEM_DRIVER=s3
PUBLIC_FILESYSTEM_DRIVER=s3
COURSE_MEDIA_AWS_ROOT=course-media
CERTIFICATE_AWS_ROOT=certificates
PUBLIC_AWS_ROOT=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
PUBLIC_AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://your-frontend.vercel.app/purchases?payment=success
STRIPE_CANCEL_URL=https://your-frontend.vercel.app/purchases?payment=cancelled
PLATFORM_FEE_BASIS_POINTS=2000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT=45
OPENAI_CONNECT_TIMEOUT=10
OPENAI_MAX_ATTEMPTS=3
OPENAI_RETRY_BASE_MS=250
OPENAI_RETRY_MAX_MS=2000
OPENAI_CHAT_MAX_OUTPUT_TOKENS=900
OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=700
OPENAI_QUIZ_MAX_OUTPUT_TOKENS=1800

SLOW_REQUEST_THRESHOLD_MS=1000
